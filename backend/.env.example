# development (default): sobe com warning se os secrets abaixo forem os defaults.
# production / prod: recusa APP_PASSWORD=admin ou JWT_SECRET_KEY=change-this-secret-key.
APP_ENV=development

APP_USERNAME=admin
APP_PASSWORD=admin
JWT_SECRET_KEY=change-this-secret-key
JWT_EXPIRE_MINUTES=60
# APP_USERNAME/APP_PASSWORD só criam o primeiro admin (e-mail admin@insight-hive.local
# se o username não tiver @). Novas contas usam POST /api/auth/register.

# --- Ollama / cobertura da análise ---
# Cada análise = 1 triagem + N especialistas + 1 síntese, em série no mesmo modelo.
# gpt-oss:20b local: N=2 é o default seguro. Subir N cobre mais eixos do card
# (churn, budget, persona…) e aumenta RAM, latência e chance de o Ollama cair.
# Um modelo menor/mais rápido pode usar MAX_SPECIALISTS até 6.
OLLAMA_MODEL=gpt-oss:20b
# No host: http://127.0.0.1:11434. No Docker dev o Compose sobrescreve
# com host.docker.internal; no prod, com http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
MAX_SPECIALISTS=2
NUM_PREDICT=512
NUM_PREDICT_SYNTHESIS=2048
# gpt-oss: low pensa pouco e separa o JSON em content. medium/high esgota
# NUM_PREDICT. Modelos sem thinking (ex.: qwen2.5) ignoram este valor.
OLLAMA_REASONING=low

# 1 = limpa transcrições no entrypoint (sem LLM extra). 0 = texto bruto, como antes.
TRANSCRIPT_CLEAN=1

# Origens permitidas no CORS (vírgula). Default cobre o Vite em :5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite local com clientes e reuniões. Caminho relativo ao diretório backend/.
DATABASE_URL=sqlite:///./data/insight_hive.db

# Teto do upload em POST /api/analysis/upload (bytes). Default 5 MiB.
MAX_UPLOAD_BYTES=5242880

# Cadastro público. Vazio = ligado em development, desligado em production.
# ALLOW_REGISTRATION=1 força o cadastro mesmo em prod.
# ALLOW_REGISTRATION=0 desliga também em development.
ALLOW_REGISTRATION=

# Teto de POST /api/auth/login e /register por IP. 0 desliga o limite.
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
